// CampusOS Prisma schema — PostgreSQL
// Source of truth: ../schema/schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Schedules ────────────────────────────────────────────────
model Schedule {
  id         String  @id
  course     String
  title      String?
  day        String
  start_time String
  end_time   String
  room       String
  instructor String?
  section    String?

  @@index([course])
  @@index([day])
}

// ─── Rooms + Bookings ─────────────────────────────────────────
model Room {
  id          String         @id
  room_number String         @unique
  type        String
  capacity    Int
  equipment   String[]       // list of equipment (e.g. ["projector","AC"])
  floor       Int
  status      String         // "available" | "unavailable"
  bookings    RoomBooking[]
}

model RoomBooking {
  booking_id String @id
  room_id    String
  booked_by  String
  date       String
  start_time String
  end_time   String
  purpose    String?
  room       Room   @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, date])
}

// ─── Events + Registrations ───────────────────────────────────
model Event {
  id            String              @id
  name          String
  description   String?
  date          String
  start_time    String
  end_time      String
  end_date      String
  venue         String?
  organizer     String?
  capacity      Int
  registered    Int                  @default(0)
  status        String              // "upcoming" | "ongoing" | "completed" | "cancelled" | "full"
  registrations EventRegistration[]

  @@index([date])
}

model EventRegistration {
  event_id   String
  student_id String
  name       String
  event      Event  @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@id([event_id, student_id])
}

// ─── Announcements ────────────────────────────────────────────
model Announcement {
  id        String  @id
  title     String
  body      String?
  date      String
  priority  String  // "high" | "medium" | "low"
  posted_by String?
  expires   String?

  @@index([date])
}

// ─── Assignments ──────────────────────────────────────────────
model Assignment {
  id                  String  @id
  course              String
  course_title        String?
  title               String
  description         String?
  assigned_date       String
  deadline            String
  submission_platform String?
  status              String  // "pending" | "submitted" | "graded" | "late"
  marks               Int     @default(0)

  @@index([course])
  @@index([deadline])
}