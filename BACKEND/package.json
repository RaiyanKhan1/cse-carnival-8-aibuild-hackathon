{
  "name": "campusos-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "CampusOS backend — Express + Prisma + PostgreSQL with per-domain controllers/services/routes",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "node src/db/seed.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@prisma/client": "^5.20.0",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  }
}
